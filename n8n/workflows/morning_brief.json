{
  "name": "Morning Brief",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }] }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/planner/execute",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"goal\": \"Generate a morning brief: check system health, summarize disk and battery status, check network connectivity, and prepare a daily startup summary\", \"user_id\": \"n8n_morning_brief\", \"context\": {\"source\": \"n8n\", \"workflow\": \"morning_brief\"}}"
      },
      "name": "Call AI Planner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"chat_id\": \"{{$env.TELEGRAM_CHAT_ID}}\", \"text\": \"☀️ *Good Morning!*\\n\\n\" + $json.result.summary, \"parse_mode\": \"Markdown\"}"
      },
      "name": "Send Telegram Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [[{ "node": "Call AI Planner", "type": "main", "index": 0 }]] },
    "Call AI Planner": { "main": [[{ "node": "Send Telegram Brief", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
