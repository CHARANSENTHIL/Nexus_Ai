{
  "name": "Coding Workspace",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "coding-workspace" },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "coding-workspace"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/planner/execute",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"goal\": \"Set up my coding workspace: check system health, open VS Code, start Docker Desktop, open GitHub in Chrome, open a terminal with the virtual environment activated, start Spotify for focus music, and close any distracting applications like games or social media\", \"user_id\": \"n8n_coding_workspace\", \"context\": {\"source\": \"n8n\", \"workflow\": \"coding_workspace\"}}"
      },
      "name": "Launch Coding Setup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"chat_id\": \"{{$env.TELEGRAM_CHAT_ID}}\", \"text\": \"💻 *Coding Workspace Ready!*\\n\\n\" + $json.result.summary, \"parse_mode\": \"Markdown\"}"
      },
      "name": "Notify Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Launch Coding Setup", "type": "main", "index": 0 }]] },
    "Launch Coding Setup": { "main": [[{ "node": "Notify Ready", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
