{
  "name": "Automatic Backup",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 23 * * *" }] }
      },
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/planner/execute",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"goal\": \"Create a backup: compress all files in the Documents, Desktop, and Projects folders and save them to C:\\\\Backups with today's date in the filename\", \"user_id\": \"n8n_backup\", \"context\": {\"source\": \"n8n\", \"workflow\": \"automatic_backup\"}}"
      },
      "name": "Call AI Planner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"chat_id\": \"{{$env.TELEGRAM_CHAT_ID}}\", \"text\": \"💾 *Daily Backup Complete*\\n\\n\" + $json.result.summary, \"parse_mode\": \"Markdown\"}"
      },
      "name": "Notify Backup Done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Daily Trigger": { "main": [[{ "node": "Call AI Planner", "type": "main", "index": 0 }]] },
    "Call AI Planner": { "main": [[{ "node": "Notify Backup Done", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" }
}
