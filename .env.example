# Nexus AI — Environment Variables Template
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ── Telegram ─────────────────────────────────────────────────
# Your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat/user ID (used for sending notifications)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Comma-separated list of allowed Telegram user IDs (whitelist)
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=123456789

# ── AI / Ollama ───────────────────────────────────────────────
# Ollama base URL — use localhost if running locally, or host.docker.internal inside Docker
OLLAMA_BASE_URL=http://localhost:11434

# ── Security ──────────────────────────────────────────────────
# JWT secret key — change this to a strong random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret-key-in-production

# ── Database ──────────────────────────────────────────────────
# PostgreSQL (used when running with Docker Compose)
DATABASE_URL=postgresql+asyncpg://nexus:nexuspassword@localhost:5432/nexusai
SYNC_DATABASE_URL=postgresql://nexus:nexuspassword@localhost:5432/nexusai

# SQLite fallback (used for local dev without Docker)
# DATABASE_URL=sqlite+aiosqlite:///./nexus_ai.db
# SYNC_DATABASE_URL=sqlite:///./nexus_ai.db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ─────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_PATH=./chroma_db

# ── Digital Twin & Health Monitor ────────────────────────────
DIGITAL_TWIN_POLL_INTERVAL_SECONDS=5
HEALTH_MONITOR_INTERVAL_SECONDS=30
DISK_ALERT_THRESHOLD_DAYS=14.0

# ── n8n ──────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=nexusn8n

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Multi-Model Local Routing Architecture (Ollama) ──
OLLAMA_ROUTER_MODEL=qwen3:1.7b
OLLAMA_SIMPLE_MODEL=qwen3:1.7b
OLLAMA_COMPLEX_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_CODING_MODEL=phi4-mini:latest

